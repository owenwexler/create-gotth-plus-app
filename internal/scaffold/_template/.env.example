# Copy to .env for local development. In production, set these in the platform's environment instead.

# "development" or "production". Production turns on HSTS, Secure cookies, JSON logs and strict
# rate limits, and removes dev-only routes such as POST /seed.
GoEnv=development

Port=3000

# Optional. SQLite database file; defaults to app.db.
DatabasePath=app.db

# Optional. The server-side cache (internal/cache): a Redis server or anything that speaks its
# protocol (Valkey, KeyDB, Dragonfly, a managed Redis), e.g. redis://localhost:6379/0, or
# rediss://user:password@host:6380/0 with TLS. Empty: no cache, so cache.CheckCache always reads
# from the database.
CacheURL=

# Optional. Goes in front of every cache key ("<prefix>:<key>"), so apps or environments can share a
# cache server. Change it to drop everything cached at once, e.g. after changing a cached type.
CacheKeyPrefix=

# Optional. If set, POST /seed (development only) requires the header "X-Admin-Key: <value>".
SeedAdminKey=
